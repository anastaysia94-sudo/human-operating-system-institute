{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosi.example/schema/claim-record.schema.json",
  "title": "HOSI Claim Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "claim",
    "domain",
    "population",
    "evidence_rating",
    "source_ids",
    "what_evidence_establishes",
    "what_evidence_does_not_establish",
    "contradictory_evidence",
    "applicability",
    "status",
    "reviewed_on",
    "reviewed_by",
    "revision_history"
  ],
  "properties": {
    "claim_id": {"type": "string", "pattern": "^CLM-[0-9]{4}$"},
    "claim": {"type": "string", "minLength": 10},
    "domain": {"type": "string", "minLength": 2},
    "study_path_tags": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "population": {"type": "string", "minLength": 2},
    "evidence_rating": {"type": "string", "enum": ["A", "B", "C", "D", "E"]},
    "evidence_basis": {"type": "string"},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^SRC-[0-9]{4}$"}
    },
    "what_evidence_establishes": {"type": "string", "minLength": 10},
    "what_evidence_does_not_establish": {"type": "string", "minLength": 10},
    "risk_of_bias_notes": {"type": "string"},
    "precision_notes": {"type": "string"},
    "consistency_or_heterogeneity": {"type": "string"},
    "contradictory_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "notes"],
      "properties": {
        "status": {"type": "string", "enum": ["not_searched", "searched_none_material_found", "material_conflict_found", "mixed_evidence"]},
        "notes": {"type": "string"},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^SRC-[0-9]{4}$"}}
      }
    },
    "applicability": {"type": "string", "minLength": 10},
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "source_matched",
        "contradiction_searched",
        "human_reviewed",
        "approved_for_curriculum",
        "held",
        "superseded"
      ]
    },
    "reviewed_on": {"type": "string", "format": "date"},
    "reviewed_by": {"type": "string", "minLength": 2},
    "human_reviewer": {"type": ["string", "null"]},
    "revision_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["date", "change", "by"],
        "properties": {
          "date": {"type": "string", "format": "date"},
          "change": {"type": "string", "minLength": 3},
          "by": {"type": "string", "minLength": 2}
        }
      }
    }
  }
}
