{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosi.example/schema/source-record.schema.json",
  "title": "HOSI Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "title",
    "source_type",
    "topics",
    "publisher_or_journal",
    "published_year",
    "url",
    "verification_state",
    "verified_on",
    "verified_by",
    "provenance",
    "limitations",
    "supersession_status"
  ],
  "properties": {
    "source_id": {"type": "string", "pattern": "^SRC-[0-9]{4}$"},
    "title": {"type": "string", "minLength": 5},
    "authors_or_owner": {"type": "string"},
    "source_type": {
      "type": "string",
      "enum": [
        "clinical_guideline",
        "consensus_statement",
        "systematic_review",
        "meta_analysis",
        "randomized_trial",
        "observational_study",
        "mechanistic_review",
        "educational_review",
        "authoritative_government_resource",
        "other_peer_reviewed"
      ]
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "publisher_or_journal": {"type": "string", "minLength": 2},
    "published_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "source_last_updated": {"type": ["string", "null"], "format": "date"},
    "doi": {"type": ["string", "null"]},
    "url": {"type": "string", "format": "uri"},
    "population": {"type": "string"},
    "design_or_scope": {"type": "string"},
    "verification_state": {
      "type": "string",
      "enum": [
        "discovered",
        "metadata_verified",
        "full_text_checked",
        "human_reviewed",
        "superseded",
        "retracted",
        "withdrawn"
      ]
    },
    "verified_on": {"type": "string", "format": "date"},
    "verified_by": {"type": "string", "minLength": 2},
    "provenance": {"type": "string", "minLength": 5},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "conflicts_or_funding_notes": {"type": ["string", "null"]},
    "supersession_status": {
      "type": "string",
      "enum": ["current_checked", "current_but_older", "supersession_check_needed", "superseded", "unknown"]
    },
    "superseded_by": {"type": ["string", "null"], "pattern": "^SRC-[0-9]{4}$"},
    "next_review_due": {"type": ["string", "null"], "format": "date"},
    "notes": {"type": "string"}
  }
}
