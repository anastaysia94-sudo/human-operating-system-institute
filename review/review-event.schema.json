{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hosi.example/schemas/review-event.schema.json",
  "title": "HOSI Review Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["review_id","gate_id","artifact","version_ref","reviewer_role","reviewer_id","review_date","decision","blocking_findings","non_blocking_findings","corrections_required","conflict_of_interest","re_review_required"],
  "properties": {
    "review_id": {"type":"string","pattern":"^REV-[0-9]{4}$"},
    "gate_id": {"type":"string","pattern":"^GATE-[0-9]{2}$"},
    "artifact": {"type":"string","minLength":1},
    "version_ref": {"type":"string","minLength":7},
    "reviewer_role": {"type":"string","enum":["subject_matter","citation_audit","medical_safety","lived_experience","accessibility","assessment","privacy_security","ai_red_team","learner_pilot","release_authority"]},
    "reviewer_id": {"type":"string","minLength":1},
    "review_date": {"type":"string","format":"date"},
    "decision": {"type":"string","enum":["pass","pass_with_nonblocking_notes","changes_required","reject","not_applicable"]},
    "blocking_findings": {"type":"array","items":{"type":"string"}},
    "non_blocking_findings": {"type":"array","items":{"type":"string"}},
    "corrections_required": {"type":"array","items":{"type":"string"}},
    "conflict_of_interest": {"type":"string","minLength":1},
    "re_review_required": {"type":"boolean"},
    "notes": {"type":["string","null"]}
  }
}